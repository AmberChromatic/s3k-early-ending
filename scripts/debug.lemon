global bool key5_state

function void Debugging.debugDraw()
{
	constant array<string> ROUTE_STATE =
	{
		"NO CLEAR",
		"AIZ CLEAR",
		"HCZ CLEAR",
		"MGZ CLEAR",
		"CNZ CLEAR",
		"GAME CLEAR",
	}
	if (Key5)
	{
		if (!key5_state)
		{
			if (earlyend.state < EARLYEND_GAMECLEAR)
			{
				++earlyend.state
			}
			else
			{
				earlyend.state = EARLYEND_NOCLEAR
			}
			
			string message = "Early End Progress: " + ROUTE_STATE[earlyend.state]
			debugLog(message)
			debugLog(earlyend.state)
			key5_state = true
		}
	}
	else
	{
		key5_state = false
	}
	
	if (Key6)
	{
		//global.active_saveslot = 0xffffe6f2
		//dataselect.slot_selected = 8
		
		EarlyEnd.saveRouteProgressForSlot()
	}
	
	debugLog("current state: " + earlyend.state)

	base.Debugging.debugDraw()
}