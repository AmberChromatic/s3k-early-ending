global bool key5_state

function void Init()
{
	playMusic(level.default_music)
	base.Init()
}

function void Debugging.debugDraw()
{
	constant array<string> ROUTE_STATE =
	{
		"NO CLEAR",
		"AIZ CLEAR",
		"HCZ CLEAR",
		"MGZ CLEAR",
		"CNZ CLEAR",
		"GAME CLEAR",
	}
	if (Key5)
	{
		if (!key5_state)
		{
			if (earlyend.state < EARLYEND_GAMECLEAR)
			{
				++earlyend.state
			}
			else
			{
				earlyend.state = EARLYEND_NOCLEAR
			}
			
			string message = "Early End Progress: " + ROUTE_STATE[earlyend.state]
			debugLog(message)
			debugLog(earlyend.state)
			key5_state = true
		}
	}
	else
	{
		key5_state = false
	}
	
	if (Key6)
	{
		//global.active_saveslot = 0xffffe6f2
		//dataselect.slot_selected = 8
		
		EarlyEnd.saveRouteProgressForSlot()
	}
	
	if (Key7)
	{
		global.active_saveslot = 0xffffe6f2
		dataselect.slot_selected = 8
		System.writeDisplayLine("slot 8 selected")
	}
	
	debugLog("current state (var): " + earlyend.state)
	
	string save = "slot_" + dataselect.slot_selected
	u32 state = System.loadPersistentData(0, 10, save, "progress", true)
	if (dataselect.slot_selected != 0)
		debugLog("current state (sram): " + state)
	else
		debugLog("playing on no save")

	base.Debugging.debugDraw()
}