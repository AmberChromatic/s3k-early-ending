//# address-hook(0x06229e) end(0x0622ac)
function void fn06229e()
{
	if (earlyend.state == EARLYEND_CNZCLEAR)
	{
		// gone for good. you can't fix what you broke now.
		UnloadObject()
		return
	}
	
	base.fn06229e()
}

//# address-hook(0x062354) end(0x06235a)
function void fn062354()
{
	if (earlyend.state == EARLYEND_MGZCLEAR)
	{
		if (objA0.subtype2c == 0x0c && objA0.base_state == 0x08)
		{
			if (global.level_flag02 < 2)
			{
				if (objA0.countdown_value > 4)
				{
					if (global.level_flag02 == 0)
					{
						global.level_flag02 = 1 // route progression opportunity
						
						objA0.collision_attributes = collision.size.8x8
						boss.remaining_hits = 1
						
						objA0.countdown_value += 0x40
					}
					else
					{
						player2.control_override = 0xff
						control.player2 = 0
						control.tails = 0
						A1 = 0xffffb04a
						objA1.velocity.x = 0
						objA1.groundspeed = 0
					}
					
					if (objA0.collision_attributes == 0)
					{
						// hit knuckles
						playSound(0x5d)
						global.level_flag02 = 2
						objA0.velocity.y = -0x300
						
						u32[A0 + 0x30] = 0x06669a		// Cutscene Knuckles balancing animation data
						objA0.animation.timer = 0
						objA0.animation.frame = 0
						
						objA0.countdown_value = 0x20
						
						A1 = 0xffffb000
						objA1.velocity.x = -0x200
						objA1.groundspeed = -0x200
						objA1.flags2a &= ~char.flag.FACING_LEFT
						player1.control_override = 0xff
						control.player1 = 0
						
						u8[A1 + 0x37] = 0x80 // protection flag
						
						u32 backupA0 = A0
						A0 = 0xffffb04a
						// Reset Tails next to Player 1
						u32 positionLookupAddress = 0xffffe500 + u32(u8(posbackup.offset.player1 - 20))

						char.render_flags = (char.render_flags & ~(render_flag.FLIP_X | render_flag.FLIP_Y)) | (objA1.render_flags & (render_flag.FLIP_X | render_flag.FLIP_Y))
						char.position.x.u16 = camera.position.x.u16 + getScreenCenterX()
						char.position.y.u16 = u16[positionLookupAddress + 2]
						char.velocity.x = 0
						char.velocity.y = 0
						char.groundspeed = 0
						char.state = char.state.STANDING
						char.jumping = 0
						char.double_jump_state = 0
						char.rotation = u8[A1 + 0x26]
						char.rotation.x = u8[A1 + 0x27]
						char.flags = (char.flags & ~0x03) | (objA1.flags2a & 0x03)
						char.control_flags = u8[A1 + 0x2e]
						char.layer_flags1 = u8[A1 + 0x46]
						char.layer_flags2 = u8[A1 + 0x47]
						
						char.invuln.countdown = 120 // invuln timer

						tails.ai_routine = 0x06
						A0 = backupA0
						
						hud.dirty.timer = 0
					}
					
					AddAsDynamicObject()
				}
				else if (objA0.countdown_value == 4)
				{
					// missed opportunity
					earlyend.state = EARLYEND_NOCLEAR
					global.level_flag02 = 0
					playSound(0x68)
					player2.control_override = 0xff
				}
			}
		}
		
		if (global.level_flag02 >= 2)
		{
			EarlyEnd.UpdateCNZKnuxCutscene()
			return
		}
	}

	base.fn062354()
}

//# address-hook(0x062458) end(0x06247a)
function void fn062458()
{
	if (global.level_flag02 == 1)
	{
		// break the barrier. teach the red man a lesson.
		UnloadObject()
		return
	}
	base.fn062458()
}

function void EarlyEnd.UpdateCNZKnuxCutscene()
{
	A1 = 0xffffb000
	D0.u16 = camera.position.x.u16 + getScreenCenterX()
	if (objA1.position.x.u16 < D0.u16)
	{
		objA1.position.x.u16 = D0.u16
		objA1.velocity.x = 0
		objA1.groundspeed = 0
	}
	
	if (objA0.value3b == 0)
	{
		// reacting to hit
		Object.AnimationProgressByLocalA1()
		
		--objA0.countdown_value
		if (objA0.countdown_value < 0)
		{
			A2 = 0xffffbde0
			u16[0xfffffaa4] = A2.u16
		
			objA0.value3b = 1
			
			objA0.update_address = 0x063de0
			objA0.mapping_offset = 0x14a8d6
			objA0.sprite_attributes = (sprite_attribute.PALETTE.LINE1 | 0x04da)
			objA0.sprite_priority = 0x0100
			objA0.box_size.x = 0x18
			objA0.box_size.y = 0x18
			objA0.hitbox_extends.x = char.hitbox.x.UPRIGHT
			objA0.hitbox_extends.y = char.hitbox.y.UPRIGHT
			objA0.render_flags = (render_flag.WORLD | render_flag.FLIP_X)
			objA0.animation.sprite = 0xd8
			boss.remaining_hits = 8
			u32[A0 + 0x30] = 0x066771		// Boss Knuckles fighting pose animation data
			u16[A0 + 0x44] = 0
			
			fn0641c4()
			
			global.level_flag02 = 3
			earlyend.swapcontrols = true
		}
	}
}