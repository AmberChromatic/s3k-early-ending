//# address-hook(0x062640) end(0x062662)
function void fn062640()
{
	// lbz1
	if (earlyend.state == EARLYEND_CNZCLEAR && camera.position.x.u16 < 0x3c21)
	{
		// it's too late.
		u8[0xfffffaa9] = 0
		u8[0xffffb000 + 0x2e] = 0		// Reset control_flags
		u8[0xffffb04a + 0x2e] = 0
		screenmover_target.right = 0x3b60 + getScreenExtend() * 2

		// "spawnSimpleChildObjects(0x084b00)" replaced by:
		spawnSimpleChildObjects(0x084a48, 1)		// Screen mover for the right border

		move_area.bottom.target = 0x0148
		fn0851e4()

		loadPaletteLine1(0x0a929c)
		
		UnloadObject()
		return
	}
}

//# address-hook(0x08cc5a) end(0x08cc82)
function void fn08cc5a()
{
	base.fn08cc5a()

	if (earlyend.state == EARLYEND_CNZCLEAR)
	{
		if (move_area.left < 0x3a10)
		{
			move_area.left += 4
		}
		
		if (move_area.left > 0x3a10)
		{
			move_area.left = 0x3a10
		}
	
		if ((level.framecounter % 3) == 0)
		{
			// explosion spawner
			if (allocDynamicObjectStd())
			{
				objA1.update_address = 0x083f4a
				objA1.position.x.u16 = camera.position.x.u16 + System.randRange(0, getScreenWidth())
				objA1.position.y.u16 = camera.position.y.u16 + System.randRange(0, getScreenHeight())
				
				if (objA1.position.x.u16 < 0x3a11)
				{
					objA1.position.x.u16 = 0x3a11 + System.randRange(0, 0x20)
				}
				
				if (objA1.position.x.u16 > 0x3bf3)
				{
					objA1.position.x.u16 = 0x3bf3 - System.randRange(0, 0x20)
				}
				
				
			}
		}
	
		A1 = 0xffffb000
		if (camera.position.x.u16 + (getScreenWidth() - 320) >= 0x3b40 && objA1.position.y.u16 >= 0x01c0)
		{
			if ((u8[A1 + 0x2a] & char.flag.IN_AIR) == 0)
			{
				playSound(0x4e)
				addPatternLoadingCue(0x083d64)		// Boss explosion sprites
				spawnSimpleChildObjects(0x06285a, 4 + getScreenExtend() / 0x20)		// More explosion spawners in widescreen
				camera.screenshake.state.hi = 0xff
			}
		}
	}
}

//# address-hook(0x08cb9e) end(0x08cbec)
function void fn08cb9e()
{
	if (earlyend.state == EARLYEND_CNZCLEAR)
	{
		// The Egg Mobile is initialized here as the main object, other parts are spawned after this
		setupObjectAttributesFull(0x08d230)

		u8[A0 + 0x29] = 0xff
		u8[0xfffffaab] = 0xff
		fn0685e2()
		move_area.left = camera.position.x.u16
		move_area.right = 0x3ae8 + getScreenExtend()

		requestLoadingPatterns(0x60)		// LBZ1 boss and pre-boss cutscene sprites

		Kosinski.addToDMAQueue(0x37567a, 0x8ac0)		// Miniboss containment box

		// "spawnChildObjects(0x06817c)" replaced by:
		spawnChildObject(0x067c38, 0x00, 0, -28)		// Robotnik head
		
		objA0.base_state = 0x06
		objA0.render_flags |= render_flag.FLIP_X
		objA0.position.x.u16 = 0x3ec0
		objA0.position.y.u16 = 0x01a0
		fn0685e2()
		
		if (allocDynamicObjectStd())
		{
			// Create the object that fades out level music and starts the Knuckles theme afterwards
			objA1.update_address = 0x085b30
			u8[A1 + 0x2c] = MUSIC_KNUCKLES
		}
		
		playSound(0x4e)
		addPatternLoadingCue(0x083d64)		// Boss explosion sprites
		camera.screenshake.state.hi = 0xff
		return
	}
}

//# address-hook(0x08cc84) end(0x08ccae)
function void fn08cc84()
{
	base.fn08cc84() 
	
	if (earlyend.state == EARLYEND_CNZCLEAR)
	{
		if (u16[0xffffeec4] != 0)
			return
			
		// "spawnChildObjects(0x081330)" replaced by:
		spawnChildObject(0x0804b0, 0x00, 0, 35)			// Egg Mobile crane hook
		spawnChildObject(0x0806da, 0x04, 0, 59)			// The Master emerald
		
		Kosinski.addToDMAQueue(0x1607d8, 0x93a0)	// Egg Mobile grabber claw sprites
		Kosinski.addToDMAQueue(0x182be6, 0x9a00)			// Master Emerald sprite tiles
		
		// load master emerald palette
		u32 source = 0x000a9dca					// dez emerald palette
		copyMemory(0xfffffc2e, source, 0x0a)
		u32 source2 = 0x000a9dbc					// dez emerald whites
		copyMemory(0xfffffc20, source2, 0x06)
	}
}

//# address-hook(0x08cce8) end(0x08cd2a)
function void fn08cce8()
{
	if (earlyend.state == EARLYEND_CNZCLEAR)
	{
		objA0.update_address = 0x08cd4c
		objA0.base_state = 0x0e
		objA0.flags38 |= 0x02
		objA0.velocity.x = 0x0300
		objA0.velocity.y = 0

		// "spawnChildObjects(0x0681b4)" replaced by:
		spawnChildObject(0x068062, 0x00, 30, 0)		// Egg Mobile exhaust flame
		return
	}
		base.fn08cce8()
}

//# address-hook(0x08ccb4) end(0x08cce6)
function void fn08ccb4()
{
	if (earlyend.state == EARLYEND_CNZCLEAR)
	{
		// overwrite this chunk
		if (u16[0xffffeec4] == 0 && level.display_routine == 0x10)
			u16[0xffffeec4] = 0x55
	}

	base.fn08ccb4()
}

//# address-hook(0x08cd4c) end(0x08cd58)
function void fn08cd4c()
{
	if (earlyend.state == EARLYEND_CNZCLEAR)
	{
		if (objA0.position.x.u16 > camera.position.x.u16 + getScreenWidth() + 0x20)
		{
			D0.u16 = (objA0.position.x.u16 & 0xff80) - level.despawn_position.x
			if (D0.u16 > 0x0180)
			{
				if (objA0.state != 0)
				{
					// make sure palette is normal
					fn08d1fc()
					objA0.velocity.x = 0
					return
				}
				
				if (u8[0xfffffab8] != 0x18)
				{
					Kosinski.addToDMAQueue(0x375358, 0x9ac0)		// Boss sprites
					
					u8[0xfffffab8] |= 0x10 // despawn emerald
					u8[0xfffffab8] |= 0x08 // despawn hook
				}
				
				if (kosinski.waiting_modules == 0)
				{
					fn08d116()
					playSound(0x50)

					// "spawnChildObjects(0x08d264)" replaced by:
					spawnChildObject(0x0723e0, 0x00, 0, 0)
					objA1.position.x.u16 = 0x3ec0
					objA1.position.y.u16 = 0x0160
					
					objA0.flags38 |= 0x10
					objA0.update_address = addressof(UnloadObject)
				}
				return
			}
		}
	}

	base.fn08cd4c()
}

//# address-hook(0x080760) end(0x08077c)
function void fn080760()
{
	if (earlyend.state == EARLYEND_CNZCLEAR && objA0.subtype2c == 4)
	{
		if (u8[0xfffffab8] & 0x10)
		{
			Object.TriggerUnloading()
			return
		}
		
		objA0.sprite_attributes &= ~sprite_attribute.PALETTE.LINE2
		objA0.sprite_attributes |= sprite_attribute.PALETTE.LINE1
	}
	
	base.fn080760()
}

//# address-hook(0x072400) end(0x07244c)
function void fn072400()
{
	base.fn072400()
	
	if (earlyend.state == EARLYEND_CNZCLEAR)
	{
		objA0.countdown_value += 0x20
		
		// backup boss palette
		copyMemory(0xfffffca0, 0xfffffc20, 0x20)
		
		for (u8 i = 0; i < 0x10; ++i)
		{
			u16[0xfffffc20 + (i * 2)] = 0x0200 // make boss palette dark blue
		}
		
		// copy ring palette
		copyMemory(0xfffffc20, 0x077412, 0x20)
		
		if (allocDynamicObjectStd())
		{
			// soz miniboss palette fade jumpscare
			objA1.update_address = 0x0855b2
			u16[A1 + 0x3a] = 0x05
			u16[A1 + 0x3c] = 0x1f
			u16[A1 + 0x30] = 0xfc20
			u16[A1 + 0x32] = 0xfca0
		}
	}
}