//# address-hook(0x062112) end(0x06211e)
function void fn062112()
{
	if (earlyend.state == EARLYEND_HCZCLEAR)
	{
		// remove knuckles, condition has been cleared
		UnloadObject()
		return
	}
	
	base.fn062112()
}

//# address-hook(0x021818) end(0x021936)
function void fn021818()
{
	if (earlyend.state == EARLYEND_HCZCLEAR)
	{
		// remove wall, condition has been cleared
		UnloadObject()
		return
	}

	if (earlyend.state == EARLYEND_AIZCLEAR && global.level_flag02 == 1)
	{
		u16[A0 + 0x30] = u16[0xffffb000 + 0x18]
		objA0.value32 = u16[0xffffb04a + 0x18]

		D1 = objA0.box_size.x + 11
		D2 = objA0.box_size.y
		D3.u16 = D2.u16 + 1
		D4.u16 = objA0.position.x.u16
		fn01dc56()
	
		A1 = 0xffffb000
		D1.u16 = u16[A0 + 0x30]
		bool canBreakWall = false
		if (super.active || u8[A1 + 0x38] == CHARACTER_KNUCKLES)
		{
			// Super/Hyper forms can break walls, and Knuckles can
			canBreakWall = true
		}
		else
		{
			// Does this wall allow for rolling into the wall? Otherwise the fire shield will do
			if ((objA0.flags2a & object.flag.P1_PUSHING) || (u8[A1 + 0x2b] & char.bonus.SHIELD_FIRE))
			{
				canBreakWall = (objA1.state == char.state.ROLLING && abs(D1.s16) >= 0x0480)
			}
		}
		
		DrawOrUnloadObject()

		if (canBreakWall)
		{
			global.level_flag02 = 2
		
			objA0.flags2a &= ~object.flag.P1_PUSHING
			fn02165a()

			A1 = 0xffffb04a
			if ((objA0.flags2a & object.flag.P2_PUSHING) && objA1.state == char.state.ROLLING)
			{
				objA0.flags2a &= ~object.flag.P2_PUSHING
				objA1.velocity.x = objA0.value32
				objA1.groundspeed = objA1.velocity.x
				objA1.flags2a &= ~char.flag.PUSHING
			}
			return
		}
		return
	}
	
	base.fn021818()
}


//# address-hook(0x062216) end(0x062230)
function void fn062216()
{
	if (earlyend.state == EARLYEND_AIZCLEAR)
	{
		global.level_flag02 = 1 // make wall breakable
	}

	base.fn062216()
}

//# address-hook(0x062232) end(0x06223e)
function void fn062232()
{
	if (earlyend.state == EARLYEND_AIZCLEAR)
	{
		// missed chance to progress route, make wall unbreakable again
		EarlyEnd.UpdateRouteProgression(EARLYEND_NOCLEAR)
		global.level_flag02 = 0
	}

	base.fn062232()
}

//# address-hook(0x062014) end(0x062014)
function void fn062014()
{
	if (objA0.update_address == 0x062124 && objA0.base_state == 0x08 && objA0.countdown_value > 0)
	{
		if (earlyend.state == EARLYEND_AIZCLEAR)
		{
			// make him fall back if wall broken, condition has been met
			if (global.level_flag02 == 2)
			{
				playMusic(MUSIC_CTRL_STOP)
				EarlyEnd.UpdateRouteProgression(EARLYEND_HCZCLEAR)
				global.level_flag02 = 0
				objA0.velocity.x = 0x400
				objA0.velocity.y = -0x200
				objA0.animation.sprite = 9
				
				loadPaletteLine1(0x0a8dfc)

				// "spawnChildObjects(0x062280)" replaced by:
				spawnChildObject(0x084aa4, 0x00, 0, 0)		// Screen mover for the upper border
				spawnChildObject(0x084a48, 0x02, 0, 0)		// Screen mover for the right border

				if (allocDynamicObjectStd())
				{
					// Create the object that fades out the Knuckles theme and starts the level music afterwards
					objA1.update_address = 0x085b0a
				}
				fn0851e4()
			}
		}
		else if (earlyend.state == EARLYEND_HCZCLEAR)
		{
			UpdateMovementSimple()
			D0.u16 = camera.position.y.u16 + getScreenHeight() + 0x40
			if (objA0.position.y.u16 > D0.u16)
			{
				UnloadObject()
			}
			return
		}
	}
	
	base.fn062014()
}

//# address-hook(0x006e9c) end(0x006eb8)
function void UpdateWaterSurfaceLevel.HCZ2()
{
	if (earlyend.state == EARLYEND_HCZCLEAR)
	{
		A1 = 0x006ec2
		fn006f2c()
		return
	}

	base.UpdateWaterSurfaceLevel.HCZ2()
}

//# address-hook(0x06aeb6) end(0x06aef8)
function void fn06aeb6()
{
#if STANDALONE
	// Skip boss in Time Attack
	if (Game.isTimeAttack())
	{
		UnloadObject()
		return
	}
#endif

	A1 = (isMainCharacter(CHARACTER_KNUCKLES) || earlyend.state == EARLYEND_HCZCLEAR) ? 0x06aea6 : 0x06ae96
	if (InitBoss(0x06aecc))
		return

	objA0.value26 = MUSIC_MAINBOSS
	StartBossFight()

#if STANDALONE
	// Expand the boss area to the right if needed
	level.bossarea.right = max(level.bossarea.right, level.bossarea.left + getScreenExtend() * 2)
#endif

	objA0.update_address = 0x06aefe
	objA0.countdown_callback = 0x06af04

	requestLoadingPatterns(0x6c)		// Boss sprites

	u16[0xfffffc1e] = 0

	loadPaletteLine1(0x06bf0a)
}

//# address-hook(0x06b0e8) end(0x06b152)
function void fn06b0e8()
{
	objA0.update_address = 0x06b154
	objA0.render_flags &= ~render_flag.VISIBLE
	level.wait_for_results = 0xff
	level.boss_encounter = 0
	screenmover_target.right = level.bossarea.left + 0x0180 + getScreenExtend()

#if STANDALONE
	if (isMainCharacter(CHARACTER_KNUCKLES) || earlyend.state == EARLYEND_HCZCLEAR)
	{
		// Correct some chunks to the right that are visible in widescreen
		u8[0xffff81a8] = 0
		u8[0xffff8238] = 0
		u8[0xffff82c8] = 0
		u8[0xffff8358] = 0
		u8[0xffff83e8] = 0
		u8[0xffff8478] = 0
		u8[0xffff8508] = 0x1f
	}
	else
	{
		screenmover_target.right += 0x30
	}
#endif

	// "spawnSimpleChildObjects(0x084b00)" replaced by:
	spawnSimpleChildObjects(0x084a48, 1)		// Screen mover for the right border

	if (allocDynamicObjectStd())
	{
		// Spawn capsule
		objA1.update_address = 0x086540
		if (!isMainCharacter(CHARACTER_KNUCKLES) && earlyend.state != EARLYEND_HCZCLEAR)
		{
			objA1.position.x.u16 = 0x4250
			objA1.position.y.u16 = 0x07e0
		}
		else
		{
			objA1.position.x.u16 = 0x4760
			objA1.position.y.u16 = 0x0360
		}
	}
}