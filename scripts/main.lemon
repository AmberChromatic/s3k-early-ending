function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	// Characters in Data Select screen character selection
	// The arrows and big portraits are compound sprites for this object, so set objA0.animation.sprite to an empty frame instead of "return true" to not skip rendering those.
	if (objA0.update_address == 0x00d42c)
	{
		u16 characters = u16[A0 + 0x34]

		if (characters <= CHARS_SONIC_ALONE && dataselect.slot_selected - 1 == objA0.flags2e)
		{
			string save = "slot_" + dataselect.slot_selected
			u8 progress = System.loadPersistentData(0, 10, save, "progress", true)
			
			
			if (progress > EARLYEND_NOCLEAR && progress < EARLYEND_GAMECLEAR)
			{
				string text = "* " + progress
				Renderer.drawText("sonic3_fontB:gradient", px, py - 130, text, 0xffffff22, 5, 0, renderQueue + 1, true, true)
			}
		}
	}

	return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}

//# address-hook(0x0067b6) end(0x0067ec)
function void SetGlobalCharacters()
{
	if (earlyend.state >= EARLYEND_MGZCLEAR && earlyend.state != EARLYEND_MINEAWESOMETHCONSTANT)
	{
		// enforce sonic & tails after mgz clear condition
		levelselect.characters = 0
		global.characters = levelselect.characters
		
		if (global.zone_act.apparent == 0x0d01)
		{
			levelselect.characters = 2
			global.characters = levelselect.characters
		}
	}

	base.SetGlobalCharacters()
}