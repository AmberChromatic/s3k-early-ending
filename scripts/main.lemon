include debug
include saving
include aiz
include hcz
include mgz
include cnz
include fight1

global u8 earlyend.state

global bool earlyend.streamermode = true

global bool earlyend.swapcontrols

constant u8 EARLYEND_NOCLEAR = 0
constant u8 EARLYEND_AIZCLEAR = 1
constant u8 EARLYEND_HCZCLEAR = 2
constant u8 EARLYEND_MGZCLEAR = 3
constant u8 EARLYEND_CNZCLEAR = 4
constant u8 EARLYEND_GAMECLEAR = 5



//# script-feature-level(2)

global u16 ClassicModeSampleMode.screenWidth


function void scriptMainEntryPoint()
{
	if (SHCSplash.shouldShowUpAfterStartup())
		SHCSplash.showSplashScreen()

	Renderer.setScreenSize(ClassicModeSampleMode.screenWidth, 224)
	System.setupCallFrame("GameModeControlLoop")
}


function void EntryFunctions.dataSelect()
{
	Renderer.setScreenSize(ClassicModeSampleMode.screenWidth, 224)
	base.EntryFunctions.dataSelect()
}


function void EntryFunctions.actSelect()
{
	Renderer.setScreenSize(ClassicModeSampleMode.screenWidth, 224)
	base.EntryFunctions.actSelect()
}


function void EntryFunctions.competitionMode()
{
	Renderer.setScreenSize(ClassicModeSampleMode.screenWidth, 224)
	base.EntryFunctions.competitionMode()
}


function void EntryFunctions.blueSphereGame()
{
	Renderer.setScreenSize(ClassicModeSampleMode.screenWidth, 224)
	base.EntryFunctions.blueSphereGame()
}


function void EntryFunctions.levelSelect()
{
	Renderer.setScreenSize(ClassicModeSampleMode.screenWidth, 224)
	base.EntryFunctions.levelSelect()
}


function void Standalone.onResumeAfterPause()
{
	Renderer.setScreenSize(ClassicModeSampleMode.screenWidth, 224)
	base.Standalone.onResumeAfterPause()
}






function u64 Standalone.getModdedSoundKey(u64 soundKey, u8 sfxId, u8 soundRegType)
{
	if (sfxId == MUSIC_KNUCKLES)
	{
		if (earlyend.state == EARLYEND_MGZCLEAR)
			return "mus_k"
	}

	return base.Standalone.getModdedSoundKey(soundKey, sfxId, soundRegType)
}

//# address-hook(0x084b18) end(0x084b5a)
function void CheckDistanceToPlayers()
{
	if (earlyend.swapcontrols)
	{
		A1 = 0xffffb000
		A2 = 0xffffb04a
		D2.s16 = objA0.position.x.u16 - objA1.position.x.u16
		D3.s16 = objA0.position.x.u16 - u16[A2 + 0x10]

		D0 = (D2.s16 < 0) ? 2 : 0
		D1 = (D3.s16 < 0) ? 2 : 0
		D2.u16 = abs(D2.s16)
		D3.u16 = abs(D3.s16)

		// Make partner always closer
		A1 = A2
		D0 = D1
		D2.u16 = D3.u16

		// Check distance-y to the closest player
		D3.s16 = objA0.position.y.u16 - objA1.position.y.u16
		D1 = (D3.s16 < 0) ? 2 : 0
		D3.u16 = abs(D3.s16)
		return
	}
	
	base.CheckDistanceToPlayers()
}


function void waitForNextFrame()
{
	base.waitForNextFrame()

	if (earlyend.swapcontrols)
	{
		control.pad2 = control.pad1
		control.pad1 = 0
	}
}

function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	// Characters in Data Select screen character selection
	// The arrows and big portraits are compound sprites for this object, so set objA0.animation.sprite to an empty frame instead of "return true" to not skip rendering those.
	if (objA0.update_address == 0x00d42c)
	{
		u16 characters = u16[A0 + 0x34]

		if (characters <= CHARS_SONIC_ALONE && dataselect.slot_selected - 1 == objA0.flags2e)
		{
			string save = "slot_" + dataselect.slot_selected
			u8 progress = System.loadPersistentData(0, 10, save, "progress", true)
			
			
			if (progress > EARLYEND_NOCLEAR && progress < EARLYEND_GAMECLEAR)
			{
				string text = "* " + progress
				Renderer.drawText("sonic3_fontB:gradient", px, py - 130, text, 0xffffff22, 5, 0, renderQueue + 1, true, true)
			}
		}
	}

	return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}