global u8 rouxls_encounter.state
global u8 rouxls_dialogue.state
global bool rouxls_encounter.disable_palettes

global string rouxls_dialogue.full
global u16 rouxls_dialogue.progress
global u16 rouxls_dialogue.timer
global bool rouxls_dialogue.draw

//# address-hook(0x028c80) end(0x028db6)
function void fn028c80()
{
	rouxls_encounter.state = 0
	rouxls_dialogue.state = 0
	rouxls_encounter.disable_palettes = false
	rouxls_dialogue.full = ""
	rouxls_dialogue.progress = 0
	rouxls_dialogue.timer = 0
	rouxls_dialogue.draw = false

	base.fn028c80()
}

function bool Standalone.onWriteToSpriteTable(s16 px, s16 py, u16 renderQueue)
{
	if (earlyend.state == EARLYEND_MINEAWESOMETHCONSTANT)
	{
		u64 key
		u8 flags = ((objA0.render_flags & render_flag.FLIP_X) ? SPRITE_FLAG_FLIP_X : 0) | ((objA0.render_flags & render_flag.FLIP_Y) ? SPRITE_FLAG_FLIP_Y : 0) | 0x08
		bool prioFlag = (objA0.sprite_attributes & sprite_attribute.PRIORITY) != 0

		if (objA0.update_address == 0x0622b2)
		{
			if (objA0.value3a > 0)
			{
				float scaleX = objA0.value3a
				scaleX = (255 - (255 - objA0.value3a)) / 255.0
				//debugLog(scaleX)
				scaleX *= 6
				
				key = "rouxls_rival_beam"
				SpriteHandle rouxls_beam = Renderer.addSpriteHandle(key, px, py, renderQueue - 1)
				rouxls_beam.setFlags(flags | prioFlag)
				rouxls_beam.setScale(scaleX, getScreenHeight())
				
				float tintOpacity = (objA0.value3a / 255.0)
				rouxls_beam.setOpacity(tintOpacity)
			}
		
			if (rouxls_encounter.state != 0)
			{
				key = stringformat("rouxls_rival_0x%02x", objA0.animation.frame)	
				SpriteHandle rouxls = Renderer.addSpriteHandle(key, px, py, renderQueue)
				rouxls.setFlags(flags)
			}
			return true
		}
	}

	return base.Standalone.onWriteToSpriteTable(px, py, renderQueue)
}

//# address-hook(0x00db44) end(0x00dbb2)
function void RenderHUD()
{
	if (rouxls_dialogue.draw)
	{
		string currentText = substring(rouxls_dialogue.full, 0, rouxls_dialogue.progress)
		
		s32 font_width = 0
		s32 font_x = 64
		
		Renderer.drawText("oxyfont_regular:gradient:outline(0x4800B4ff,1,true):shadow(1,1,0.5f,1.0f)", font_x, 64, currentText, 0xFCFCFCFF, 1, 2, 0xa000, false, true)
	}
	
	base.RenderHUD()
}

// button
//# address-hook(0x065bd4) end(0x065bf6)
function void fn065bd4()
{
	if (earlyend.state == EARLYEND_MINEAWESOMETHCONSTANT)
	{
		if (global.zone_act.apparent == 0x0301)
		{
			if (rouxls_encounter.state < 2)
				return
				
			if (allocDynamicObjectStd())
			{
				// "spawnSimpleChildObjects(0x083ff6)" replaced by:
				spawnChildObject(addressof(SmallExplosion.BaseUpdate), 0, 0, 0)
				if (_equal())
				{
					objA1.base_state = 0x02
				}
			}
		}
	}
	base.fn065bd4()
}

// ditto
//# address-hook(0x065c04) end(0x065c3a)
function void fn065c04()
{
	if (earlyend.state == EARLYEND_MINEAWESOMETHCONSTANT)
	{
		if (global.zone_act.apparent == 0x0301)
		{
			D1.u16 = 0x13
			D2.u16 = 0x04
			D3.u16 = 0x05
			D4.u16 = objA0.position.x.u16
			fn01dc56()

			D3 = 0
			if (objA0.flags2a & object.flag.P1_ON_OBJECT)
			{
				// Button is pressed
				playSound(SFX_CLICK)
				objA0.update_address = 0x065c50
				objA0.animation.sprite = 1
				u8[0xfffffaa9] = 0xff
				objA0.respawn_entry = 0
				
				rouxls_encounter.state = 16
				rouxls_dialogue.progress = 0
				level.default_music = MUSIC_CTRL_STOP
				playMusic(MUSIC_CTRL_STOP)

				// Targets:
				//  - 0x065c56	-> objA0.subtype2c = 0x00  -> In AIZ 2 cutscene
				//  - 0x065c72	-> objA0.subtype2c = 0x02  -> In HCZ 2 cutscene
				//  - 0x065c78	-> objA0.subtype2c = 0x04  -> In CNZ 2 lights-off cutscene
				//  - 0x065cac	-> objA0.subtype2c = 0x06  -> In CNZ 2 pre-boss cutscene
				call tableLookupAddress(0x065c40, objA0.subtype2c)
				
				A1 = 0xffffb000
				StopObjectA1()
				player1.control_override = 0xff
				control.player1 = 0
				objA1.position.x.u16 = objA0.position.x.u16
			}
		}
	}
	
	base.fn065c04()
}

// ditto
//# address-hook(0x065c50) end(0x065c50)
function void fn065c50()
{
	if (earlyend.state == EARLYEND_MINEAWESOMETHCONSTANT)
	{
		if (global.zone_act.apparent == 0x0301)
		{
			D1.u16 = 0x13
			D2.u16 = 0x04
			D3.u16 = 0x05
			D4.u16 = objA0.position.x.u16
			fn01dc56()
		}
	}

	base.fn065c50()
}

// invisible walleth
//# address-hook(0x062458) end(0x06247a)
function void fn062458()
{
	if (earlyend.state == EARLYEND_MINEAWESOMETHCONSTANT && rouxls_encounter.state != 0)
	{
		if (allocDynamicObjectStd() && water.height.current == 0x033b && System.getGlobalVariableValueByName("MFT_CNZ2_AltCutscene") == 1)
		{
			if (System.getGlobalVariableValueByName("MFT_ExtraCutsceneSFX") == 2)
				playSound(0x78)
			
			objA1.update_address = 0x062480
		}

		A1 = 0xffff0000 + u16[A0 + 0x46]
		if (u8[A1 + 0x2a] & 0x80)
		{
			UnloadObject()
			return
		}

		objA0.box_size.x = 0x08
		objA0.position.y.u16 = camera.position.y.u16 + getScreenHeight()
		D1 = 0x13
		D2.u16 = 0x0060
		D3.u16 = 0x0060
		D4.u16 = objA0.position.x.u16
		CheckCharacterOnClimbableObject()
		return
	}
	
	base.fn062458()
}

//# address-hook(0x002384) end(0x00243e)
function void LevelPaletteUpdate.CNZ()
{
	if (earlyend.state == EARLYEND_MINEAWESOMETHCONSTANT)
	{
		if (rouxls_encounter.disable_palettes)
			return
	}
		
	base.LevelPaletteUpdate.CNZ()
}